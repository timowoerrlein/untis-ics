# One user and password pair per child (a student login of WebUntis), named in config.json.
ANNA_USER=
ANNA_PASSWORD=
BEN_USER=
BEN_PASSWORD=
# Optional: the feeds are served at /<FEED_TOKEN>/<name>.ics, so the address is not guessable.
FEED_TOKEN=
PORT=8080
# Optional: homework as tasks in FamilyOS (key of a connected app; address of FamilyOS as the container sees it).
FAMOS_URL=
FAMOS_KEY=
